    "src",
    "examples",
    "README.md",
    "ROADMAP.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "douyin",
    "tiktok-china",
    "cli",
    "digest",
    "cdp",
    "browser-automation",
    "zero-dependency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmxiao/douyin-digest.git"
  },
  "scripts": {
    "start": "node bin/cli.mjs"
  },
  "homepage": "https://github.com/pcmxiao/douyin-digest#readme",
  "bugs": {
    "url": "https://github.com/pcmxiao/douyin-digest/issues"
  }
